{
  "display_information": {
    "name": "CalendarBot",
    "description": "メンションするだけで自然言語からGoogleカレンダーへ予定を登録します",
    "background_color": "#1f2d3d"
  },
  "features": {
    "bot_user": {
      "display_name": "CalendarBot",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write", "im:history", "im:read", "im:write", "users:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
