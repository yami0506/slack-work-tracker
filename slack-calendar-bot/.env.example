# ============================================================
# Slack Calendar Bot - 環境変数サンプル
# cp .env.example .env して値を埋めてください（.env はコミット禁止）
# すべて無料枠で運用できる構成です。
# ============================================================

# --- 動作モード -------------------------------------------------
# http  : 本番（Events API を HTTP で受信 / Cloud Run など）※既定
# socket: ローカル開発（外部公開URL不要 / Socket Mode）
SLACK_MODE=http
PORT=8080
LOG_LEVEL=info

# OAuth のリダイレクト先を組み立てるためのベースURL
# ローカルは http://localhost:8080 、本番は https://<your-service>.run.app
APP_BASE_URL=http://localhost:8080

# --- Slack ------------------------------------------------------
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing Secret（署名検証に使用。http モードでは必須）
SLACK_SIGNING_SECRET=your-signing-secret
# App-Level Token (xapp-...)。socket モードでは必須
SLACK_APP_TOKEN=

# --- 自然言語解析 (Gemini 無料枠) --------------------------------
# https://aistudio.google.com/apikey で発行（無料枠あり・クレジットカード不要）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# 0 で thinking を無効化（無料枠の消費とレイテンシを抑える）
GEMINI_THINKING_BUDGET=0

# --- Supabase (Free プラン) --------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# service_role キー（サーバー側でのみ使用。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google OAuth / Calendar ------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Google Cloud Console の「承認済みのリダイレクト URI」と完全一致させる
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# --- 暗号化 -----------------------------------------------------
# Google のアクセストークン / リフレッシュトークンを AES-256-GCM で暗号化する鍵
# 生成: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# --- 既定値 -----------------------------------------------------
DEFAULT_TIMEZONE=Asia/Tokyo
DEFAULT_CALENDAR_ID=primary
# 確認メッセージの有効期限（分）
PENDING_EVENT_TTL_MINUTES=30
